{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}-fabric",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "sources": "https://github.com/Rebel459/drops_backported"
  },
  "license": "${license}",
  "icon": "assets/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.rebel459.drops_backported.DropsBackportedFabric"
    ],
    "client": [
      "net.rebel459.drops_backported.DropsBackportedFabricClient"
    ]
  },
  "mixins": [
    "drops_backported.mixins.json",
    "drops_backported-fabric.mixins.json"
  ],
  "accessWidener": "drops_backported.classtweaker",
  "depends": {
    "fabricloader": ">=0.18",
    "fabric-api": "*",
    "minecraft": "${fabric_minecraft_version}",
    "java": ">=25",
    "unified": "*",
    "cloth-config": "*"
  }
}